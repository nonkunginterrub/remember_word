# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (หรือรัน `vercel env pull .env.local`)

# Connection string ของ Neon Postgres (Vercel ใส่ให้อัตโนมัติเมื่อเชื่อม Neon ผ่าน Storage)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# สตริงลับสำหรับเซ็น JWT — ยาวอย่างน้อย 32 ตัวอักษร
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
